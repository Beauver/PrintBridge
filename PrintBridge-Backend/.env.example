# Settings of the backend when you run it from source. Copy to PrintBridge-Backend/.env
# (git-ignored) and change what you need: Quarkus reads a .env from the directory it is started
# in, which is this one for `./gradlew quarkusDev`.
#
# Everything here is optional in dev mode: the defaults match the stack in ../local.
# For running the published images, see ../deploy instead.

# --- Database (PostgreSQL) ---
# DB_URL=jdbc:postgresql://localhost:5432/printbridge
# DB_USER=printbridge
# DB_PASSWORD=change-me

# --- File storage ---
# Relative paths start at this directory. Never a directory a web server serves.
# STORAGE_PATH=./local/data/uploads
# Ceiling per file in MB; the admin sets the actual limit (and max files per request) in
# Settings -> Uploads.
# UPLOAD_MAX_SIZE_MB=100
# UPLOAD_ALLOWED_EXTENSIONS=stl,3mf

# --- 3D preview ---
# Models with more placed triangles than this get no preview (printbridge.preview.max-triangles).
# PRINTBRIDGE_PREVIEW_MAX_TRIANGLES=2000000

# --- Server slicing (the slicer in ../local; switch it on in Settings -> Slicing) ---
# SLICER_URL=http://localhost:18000

# --- Spoolman (the Spoolman in ../local; switch it on in Settings -> Spoolman) ---
# SPOOLMAN_URL=http://localhost:7912
# How long the filament list is kept, in seconds.
# SPOOLMAN_CACHE_TTL_SECONDS=60

# --- Licence (AGPL-3.0-or-later) ---
# The app's footer links here. If you run a changed version for others, point it at your source.
# SOURCE_URL=https://github.com/Beauver/PrintBridge

# --- Auth ---
# Dev mode and tests generate a throwaway key pair; outside dev mode both paths are required
# (see ../docs/deployment.md).
# JWT_PRIVATE_KEY_PATH=/path/to/privateKey.pem
# JWT_PUBLIC_KEY_PATH=/path/to/publicKey.pem
# JWT_ISSUER=printbridge
# JWT_ACCESS_TOKEN_TTL=15M
# REFRESH_TOKEN_TTL=14D
# How long a just-replaced refresh token is still accepted (several tabs loading at once).
# REFRESH_TOKEN_GRACE=10S
# Login throttling (10 logins a minute per address, 5 failed logins per account and address in
# 15 minutes). Uncomment to switch it off.
# RATE_LIMIT_ENABLED=false
# The backend takes the client's address from the X-Forwarded-For header a proxy sets. Uncomment
# when clients reach the backend directly, without a proxy.
# TRUST_PROXY_HEADERS=false
# The refresh cookie is Secure outside dev mode: browsers only send it over HTTPS (Chrome and
# Firefox also on http://localhost). Uncomment only for a plain-http run where login doesn't stick.
# AUTH_COOKIE_SECURE=false

# --- CORS ---
# The address of the web app when it is on another origin than the API. Dev mode allows any.
# FRONTEND_ORIGIN=http://localhost:4200
