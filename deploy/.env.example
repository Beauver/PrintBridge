# Copy to deploy/.env (git-ignored) and edit. Used by deploy/docker-compose.yml.
# See docs/deployment.md for what each setting does.

# --- Required ---
# The address users open in their browser, without a trailing slash.
PUBLIC_URL=https://print.example.com
# Pick a long random password, e.g. `openssl rand -base64 32`.
POSTGRES_PASSWORD=

# --- Where the app listens on this machine ---
# The app speaks plain HTTP here; put a reverse proxy with HTTPS in front (docs/deployment.md).
# 127.0.0.1 keeps it reachable only from this machine, which is what a reverse proxy on the same
# host needs. Use 0.0.0.0 only when the proxy runs on another machine.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# --- Version ---
# A release tag such as 1.2.0, or latest.
PRINTBRIDGE_VERSION=latest

# --- Optional ---
# Ceiling per uploaded file in MB, for nginx and the backend; the admin sets the actual limit in
# Settings -> Uploads. A reverse proxy in front needs to allow this much too.
# UPLOAD_MAX_SIZE_MB=100
# Server slicing: start with `docker compose --profile slicer up -d`, then uncomment.
# SLICER_URL=http://slicer:8000
# Only for a test without HTTPS: login doesn't stick over plain http otherwise.
# AUTH_COOKIE_SECURE=false
# If you run a changed version for others, point this at your source (AGPL-3.0).
# SOURCE_URL=https://github.com/Beauver/PrintBridge
# POSTGRES_DB=printbridge
# POSTGRES_USER=printbridge
TZ=UTC
