# Copy to .env and adjust. Never commit .env.
# Used by the backend (export / IDE run config) and by local/docker-compose.yml (via local/.env).

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=printbridge
DB_USER=printbridge
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# --- Spoolman (read-only, backend only) ---
SPOOLMAN_URL=http://localhost:7912
SPOOLMAN_CACHE_TTL_SECONDS=60

# --- File storage (outside web root; mount a volume in production) ---
STORAGE_PATH=./local/data/uploads
# Ceiling per file; the admin sets the actual limit (and max files per request) in Settings → Uploads.
UPLOAD_MAX_SIZE_MB=100
UPLOAD_ALLOWED_EXTENSIONS=stl,3mf

# --- Server slicing (optional, PrintBridge-Slicer; switch it on in the admin settings) ---
SLICER_URL=http://localhost:18000

# --- Licence (AGPL-3.0-or-later) ---
# The app's footer links here. If you run a changed version for others, point it at your source.
SOURCE_URL=https://github.com/Beauver/PrintBridge

# --- Auth (SmallRye JWT) ---
# Generate keys: see local/README.md
JWT_PRIVATE_KEY_PATH=./local/keys/privateKey.pem
JWT_PUBLIC_KEY_PATH=./local/keys/publicKey.pem
JWT_ISSUER=printbridge
JWT_ACCESS_TOKEN_TTL=15M
REFRESH_TOKEN_TTL=14D
# Keep true in production (HTTPS). Set false only for plain-http local runs.
AUTH_COOKIE_SECURE=false
# The admin account is created in the browser on first start (setup page).

# --- CORS / frontend ---
FRONTEND_ORIGIN=http://localhost:4200
