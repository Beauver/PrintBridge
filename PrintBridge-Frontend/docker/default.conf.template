# Rendered by the nginx image at startup (envsubst on ${BACKEND_URL} and ${UPLOAD_MAX_SIZE_MB}).
server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # API on the same origin as the app, so the refresh-token cookie stays first-party.
  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_set_header Host $host;
    # The backend counts rate limits by this address. $remote_addr, not $proxy_add_x_forwarded_for:
    # that one keeps whatever the client put in the header, so a client could pick its own address.
    # With another reverse proxy in front of this one, every client has that proxy's address here
    # unless nginx is told to trust it (set_real_ip_from / real_ip_header).
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    # The same ceiling as the backend; above it nginx answers 413 before the backend sees it.
    client_max_body_size ${UPLOAD_MAX_SIZE_MB}m;
  }

  # Hashed assets can be cached aggressively
  location ~* \.(?:js|css|woff2?|png|jpg|svg|ico)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # SPA fallback
  location / {
    try_files $uri $uri/ /index.html;
  }
}
