# Copy to local/.env (git-ignored). Used by local/docker-compose.yml.
COMPOSE_PROJECT_NAME=printbridge

POSTGRES_DB=printbridge
POSTGRES_USER=printbridge
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

SPOOLMAN_PORT=7912
# Optional slicer service (docker compose --profile slicer up -d); the backend's SLICER_URL points here.
SLICER_PORT=18000
TZ=Europe/Brussels
