# Copy to local/.env (git-ignored). Used by local/docker-compose.yml.
COMPOSE_PROJECT_NAME=printbridge

POSTGRES_DB=printbridge
POSTGRES_USER=printbridge
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Slicer service; the backend's SLICER_URL points here in dev mode.
SLICER_PORT=18000

# Spoolman's web UI; the backend's SPOOLMAN_URL points here in dev mode.
SPOOLMAN_PORT=7912
# Spoolman image tag (default: latest).
# SPOOLMAN_VERSION=latest

# Time zone of the containers (default: UTC).
TZ=Europe/Brussels
